<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/kirmizi"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <!-- Başlık -->
    <LinearLayout style="@style/Baslik">
        <TextView
            android:id="@+id/btnGeri"
            style="@style/BaslikButon"
            android:layout_marginEnd="4dp"
            android:contentDescription="Geri"
            android:text="←" />
        <TextView
            android:id="@+id/tvKod"
            style="@style/BaslikYazi"
            android:textSize="24sp" />
        <TextView
            android:id="@+id/btnMenu"
            style="@style/BaslikButon"
            android:contentDescription="Menü"
            android:text="⋮" />
        <ImageView
            style="@style/BaslikLogo"
            android:contentDescription="İETT" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/beyaz"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Özet -->
        <TextView
            android:id="@+id/tvOzet"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/kirmizi_acik"
            android:lineSpacingExtra="4dp"
            android:padding="14dp"
            android:textColor="@color/siyah"
            android:textSize="15sp" />

        <Button
            android:id="@+id/btnYeni"
            style="@style/AnaButon"
            android:layout_width="match_parent"
            android:layout_marginTop="12dp"
            android:text="+  YENİ DENETİM KAYDI" />

        <RadioGroup
            android:id="@+id/rgFiltre"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/rbTumu"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:buttonTint="@color/kirmizi"
                android:checked="true"
                android:text="Tümü"
                android:textColor="@color/siyah" />

            <RadioButton
                android:id="@+id/rbAcik"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:buttonTint="@color/kirmizi"
                android:text="Açık"
                android:textColor="@color/siyah" />

            <RadioButton
                android:id="@+id/rbGiderilen"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.3"
                android:buttonTint="@color/kirmizi"
                android:text="Giderilen"
                android:textColor="@color/siyah" />
        </RadioGroup>

        <ListView
            android:id="@+id/lvKayitlar"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            android:layout_weight="1"
            android:divider="@android:color/transparent"
            android:dividerHeight="8dp" />

        <TextView
            android:id="@+id/tvBos"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:padding="24dp"
            android:text="Bu araç için kayıt yok."
            android:textColor="@color/gri"
            android:textSize="16sp"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>

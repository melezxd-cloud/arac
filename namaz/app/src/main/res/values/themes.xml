<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="android:Theme.Material.NoActionBar">
        <item name="android:colorPrimary">@color/zemin</item>
        <item name="android:colorPrimaryDark">@color/zemin_koyu</item>
        <item name="android:colorAccent">@color/altin</item>
        <item name="android:statusBarColor">@color/zemin</item>
        <item name="android:navigationBarColor">@color/zemin_koyu</item>
        <item name="android:windowBackground">@color/zemin</item>
        <item name="android:textColorPrimary">@color/krem</item>
        <item name="android:alertDialogTheme">@style/DialogTheme</item>
    </style>

    <style name="DialogTheme" parent="android:Theme.Material.Dialog.Alert">
        <item name="android:colorAccent">@color/altin</item>
        <item name="android:textColorPrimary">@color/krem</item>
    </style>

    <style name="VakitAdi">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:textColor">@color/krem_yumusak</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="VakitSaati">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/krem</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>

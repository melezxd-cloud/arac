<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/arka_plan"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    android:paddingStart="22dp"
    android:paddingTop="24dp"
    android:paddingEnd="22dp"
    android:paddingBottom="8dp">

    <!-- Başlık: il adı + tarihler + il seç butonu -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvIl"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="—"
                android:textColor="@color/krem"
                android:textSize="27sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvTarih"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:textColor="@color/yesil_acik"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvHicri"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/altin"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/btnIlSec"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/buton_cerceve"
            android:clickable="true"
            android:focusable="true"
            android:drawableStart="@drawable/ic_konum"
            android:drawablePadding="6dp"
            android:gravity="center"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="İl seç"
            android:textColor="@color/krem"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Sonraki vakte kalan süre -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:background="@drawable/sayac_kutu"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="16dp"
        android:paddingEnd="20dp"
        android:paddingBottom="16dp">

        <TextView
            android:id="@+id/tvSonrakiBaslik"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.1"
            android:text="SONRAKİ VAKİT"
            android:textColor="@color/altin"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvSayac"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="--:--:--"
            android:textColor="@color/krem"
            android:textSize="42sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvSayacAlt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/mavi_metin"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Uyarı satırı: izin gerekiyor / internet yok -->
    <TextView
        android:id="@+id/tvUyari"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/buton_cerceve"
        android:clickable="true"
        android:focusable="true"
        android:lineSpacingExtra="2dp"
        android:padding="14dp"
        android:textColor="@color/krem"
        android:textSize="13sp"
        android:visibility="gone" />

    <!-- Altı vakit: satırlar koddan eklenir -->
    <LinearLayout
        android:id="@+id/vakitListesi"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:orientation="vertical" />

    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Google Ads banner -->
    <com.google.android.gms.ads.AdView
        android:id="@+id/reklam"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="8dp" />

</LinearLayout>

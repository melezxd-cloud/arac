<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/arka_plan"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    android:paddingStart="22dp"
    android:paddingTop="24dp"
    android:paddingEnd="22dp"
    android:paddingBottom="12dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="İl seçin"
        android:textColor="@color/krem"
        android:textSize="24sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/etArama"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="14dp"
        android:background="@drawable/kutu_arama"
        android:hint="İl ara"
        android:importantForAutofill="no"
        android:inputType="text"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:singleLine="true"
        android:textColor="@color/krem"
        android:textColorHint="@color/yesil_soluk"
        android:textSize="16sp" />

    <ListView
        android:id="@+id/lvIller"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_weight="1"
        android:divider="#1F5B45"
        android:dividerHeight="1dp" />
</LinearLayout>
